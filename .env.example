# Copy this file to .env and fill in your actual Supabase project values.
# Find these in your Supabase dashboard: Project Settings → API
# Never commit the real .env file — it's already in .gitignore.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Set to true once the Google provider is switched on in Supabase
# (Authentication -> Sign In / Providers -> Google). It shows the
# "Sign in with Google" button on the login page.
VITE_GOOGLE_LOGIN=false
